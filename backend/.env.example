# ==============================================
# Backend Environment Variables
# Copy to backend/.env
# ==============================================

ENVIRONMENT=development
DEBUG=True
APP_NAME="JA Assure AI Marketing Agent Backend"
API_V1_STR=/api/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================
# Supabase Project Configuration
# ==============================================
# 1. Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Public API Key
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Backend Administrative Access)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Supabase PostgreSQL Connection String (Session / Transaction Pooler)
# Dashboard -> Project Settings -> Database -> Connection string (URI)
# Direct connection: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Transaction pooler: postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_supabase_password_here@db.your_supabase_project_ref.supabase.co:5432/postgres

# ==============================================
# Groq API Configuration (leave blank for local mock/demo provider mode)
# ==============================================
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# ==============================================
# Google Gemini Images (PRIMARY AI visual provider -- used for AI-generated video
# scene visuals). Leave blank to fall through to OpenAI/Hugging Face/branded
# fallback. Get a key at https://aistudio.google.com/apikey
# ==============================================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=models/gemini-2.5-flash-image

# ==============================================
# OpenAI Images API (optional secondary/legacy AI image vendor)
# Leave blank to use the clearly-labeled branded fallback card instead of
# real AI-generated images. Get a key at https://platform.openai.com/api-keys
# ==============================================
OPENAI_API_KEY=

# ==============================================
# Hugging Face Inference Providers (optional secondary AI image vendor)
# Leave HF_TOKEN blank to keep this provider unavailable. Get a token at
# https://huggingface.co/settings/tokens
# ==============================================
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# ==============================================
# Stable Diffusion 1.5 (local, third-tier fallback -- no API key needed, runs on
# this machine). Requires `pip install diffusers torch` first -- see README's
# "Stable Diffusion 1.5 (Local) Setup" section; NOT installed/downloaded by
# default. SD15_MODEL_PATH can be a Hugging Face model id (downloaded to the
# local HF cache on first use) or an already-downloaded local directory.
# ==============================================
SD15_MODEL_PATH=runwayml/stable-diffusion-v1-5
SD15_DEVICE=auto
SD15_LOW_VRAM=False
SD15_NUM_INFERENCE_STEPS=25
SD15_GUIDANCE_SCALE=7.5
SD15_WIDTH=512
SD15_HEIGHT=768
SD15_SEED=-1

# Which image provider video generation should use for scene visuals:
# "auto" (default) cascades Gemini -> Hugging Face -> Stable Diffusion 1.5
# (local) -> branded fallback, stopping at the first real success. Set to one
# specific value ("gemini" | "openai" | "huggingface" | "stable_diffusion" |
# "branded_fallback") to force that single provider only (no cascade, no API call
# for "branded_fallback").
IMAGE_PROVIDER=auto

# ==============================================
# LinkedIn Publishing (The Hands -- optional). Leave blank to keep LinkedIn
# publishing unconfigured; publish attempts will fail honestly rather than
# faking success. LINKEDIN_ACCESS_TOKEN is used directly by linkedin_client.py --
# get one either by pasting in a token obtained externally, OR by using the
# in-app OAuth flow below (GET /api/v1/auth/linkedin/login), which fills this in
# for you automatically. LINKEDIN_ORGANIZATION_ID is optional -- leave blank to
# post under the authenticated member's own profile instead of a company page
# (this is also what the OAuth flow below does by default).
# ==============================================
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# In-app LinkedIn OAuth flow (member posting only, "openid profile
# w_member_social" scope -- never requests organization/company-page access).
# All three required to use GET /api/v1/auth/linkedin/login. Create an app at
# https://www.linkedin.com/developers/apps, then under its "Auth" tab: add the
# redirect URL below under "Authorized redirect URLs for your app", and request
# the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products (these grant the openid/profile and w_member_social scopes).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# ==============================================
# Automatic background publishing worker (Project 2). SAFE DEFAULT IS DISABLED --
# starting the app never begins automatic publishing unless explicitly enabled.
# When enabled, polls every PUBLISH_WORKER_INTERVAL_SECONDS and publishes through
# the exact same gated path the manual /publishing/worker/run-once endpoint uses;
# human approval remains absolute either way.
# ==============================================
PUBLISH_WORKER_ENABLED=False
PUBLISH_WORKER_INTERVAL_SECONDS=60

# ==============================================
# Email outreach sending (optional). "mock" (default) never sends a real email --
# it logs and returns a clearly-labeled mock result, safe with zero setup. Set to
# "smtp" and fill in the SMTP_* fields to send real email via any standard SMTP
# provider (Gmail, SendGrid's SMTP relay, Resend's SMTP endpoint, etc.) -- only
# ever for LeadOutreach rows a human has already approved.
# ==============================================
EMAIL_PROVIDER=mock
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==============================================
# FFmpeg / ffprobe (optional -- only needed if auto-discovery can't find them)
# The backend auto-discovers both from PATH, then (on Windows) common install
# locations like the WinGet package store. Set these only if auto-discovery fails
# -- e.g. a non-standard install location -- to the full path of the executable.
# ==============================================
FFMPEG_PATH=
FFPROBE_PATH=

LOG_LEVEL=INFO
DEFAULT_BRANDS=jade,doctorshield,jaguartransit

# ==============================================
# Gemini Image Generation (primary AI visual provider for video scene visuals).
# Leave blank to skip straight to OpenAI/Hugging Face/branded fallback. Get a key
# at https://aistudio.google.com/apikey
# ==============================================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=